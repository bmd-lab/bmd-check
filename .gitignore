# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
.tox/
.nox/

# Environments
.venv/
venv/

# Local configuration and secrets
.env
.env.*
!.env.example
resources.toml
config/resources.toml
config/resources.local.toml
config/resources.*.toml
!config/resources.example.toml
secrets.*
*.secrets.*

# Private keys and credential containers
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*

# Licensed VASP potential data
POTCAR
POTCAR.*
!POTCAR.spec
!**/POTCAR.spec

# Agent runtime state
state/
logs/
tasks/
workspaces/

# Databases
*.db
*.sqlite
*.sqlite3

# Editors / OS
.vscode/
.idea/
.DS_Store
*~
*.swp
*.swo

# Maintainer staging directories for corpus acquisitions are never
# committed; only a reviewed release under src/ is.
corpus-staging/

# The VASP Wiki corpus pages are verbatim wikitext, never potential data. On
# case-insensitive checkouts (core.ignorecase=true, the Windows default) the
# POTCAR rules above would otherwise silently drop pages/potcar.r*.wiki from a
# commit. Keep this rule last so that no earlier pattern can hide a page.
!src/bmd_agent/reference_corpus/vasp_wiki/pages/*.wiki
